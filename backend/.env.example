
# Copy this file to .env and fill in real values once Mrinal shares the database details.
# Never commit the real .env file (with real credentials) to git.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=capstone_db
DB_USER=postgres
DB_PASSWORD=

# Keep this "true" until the real PostgreSQL connection is built and tested.
# Switch to "false" once routers are updated to query the real database.
USE_MOCK_DATA=true
