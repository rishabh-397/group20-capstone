# Copy to .env and adjust if the backend moves.
VITE_API_BASE=http://127.0.0.1:8000/api/v1

# Paths (only set these if they differ from the defaults)
VITE_EP_KPIS=/kpis/
VITE_EP_SALES=/sales/overview
VITE_EP_SEGMENTATION=/segmentation/
VITE_EP_FORECAST=/forecast/

# "false" turns off the bundled sample-data fallback and shows hard errors instead
VITE_DEMO_FALLBACK=true
